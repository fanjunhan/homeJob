.page {
  padding: 24rpx;
}

.sig-canvas {
  width: 100%;
  height: 320rpx;
  background: #FCFCFD;
  border: 2rpx dashed #C9CDD4;
  border-radius: 16rpx;
  touch-action: none;
  display: block;
}

.sig-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.mini-btn {
  font-size: 24rpx;
  color: #646A73;
  border: 1rpx solid #D3D9E0;
  border-radius: 8rpx;
  padding: 6rpx 20rpx;
}

.sig-tip {
  font-size: 22rpx;
  color: #8A9099;
  margin-top: 4rpx;
}

.sig-tip.ok {
  color: #0F6E56;
}

.legal {
  font-size: 22rpx;
  color: #8A9099;
  text-align: center;
  line-height: 1.8;
  padding: 20rpx 40rpx 40rpx;
}
