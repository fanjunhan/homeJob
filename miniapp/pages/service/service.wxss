.page {
  padding: 24rpx;
}

.card-title.big {
  font-size: 34rpx;
  margin-bottom: 6rpx;
}

.notice {
  font-size: 24rpx;
  color: #854F0B;
  background: #FFF7E8;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.done-tip {
  text-align: center;
  color: #3B6D11;
  font-size: 26rpx;
  padding: 30rpx 0;
}

.sign-preview {
  width: 100%;
  margin: 16rpx 0 8rpx;
  border: 1rpx solid #F1F2F4;
  border-radius: 12rpx;
  background: #FCFCFD;
}
